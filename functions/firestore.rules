rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.active == true;
    }
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['displayName','email','createdAt'])
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName']);
      allow delete: if false;
    }
    match /loanApplications/{id} {
      allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin();
      allow write: if false; // use validated Cloud Functions only
    }
    match /loans/{id} { allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin(); allow write: if false; }
    match /payments/{id} { allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin(); allow write: if false; }
    match /installments/{id} { allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin(); allow write: if false; }
    match /offers/{id} { allow read: if resource.data.published == true || isAdmin(); allow write: if false; }
    match /settings/{id} { allow read, write: if false; }
    match /adminRoles/{uid} { allow read: if isAdmin() && request.auth.uid == uid; allow write: if false; }
    match /auditLogs/{id} { allow read: if isAdmin(); allow write: if false; }
    match /depositTransactions/{id} { allow read: if (signedIn() && resource.data.uid == request.auth.uid) || isAdmin(); allow write: if false; }
    match /notificationQueue/{id} { allow read, write: if false; }
  }
}
